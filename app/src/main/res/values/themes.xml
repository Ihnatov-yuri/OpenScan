<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme for the (Compose-only) app. We use a plain Material
        NoActionBar parent so the app does not need the AppCompat dependency.
        All real theming happens in Compose (see ui/theme).
    -->
    <style name="Theme.OpenScan" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/scanner_primary</item>
    </style>
</resources>
